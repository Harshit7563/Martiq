# Same Web client ID as frontend VITE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=
PORT=8080
# Comma-separated allowed frontends
CORS_ORIGIN=http://localhost:5173,https://martiq.in,https://www.martiq.in

# Postgres (local martiq catalogue)
PG_HOST=localhost
PG_PORT=5432
PG_USER=harshit
PG_PASSWORD=
PG_DATABASE=martiq
# Or use a single URL instead:
# DATABASE_URL=postgres://harshit@localhost:5432/martiq

# EmailJS — signup email OTP
# Dashboard: https://dashboard.emailjs.com/
# Template To Email field must be: {{to_email}}
# Template vars: {{passcode}} {{time}} {{name}} {{to_email}} {{email}}
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_SERVICE_ID=default_service
EMAILJS_TEMPLATE_ID=
